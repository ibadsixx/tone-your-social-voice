# Tone Frontend — Vite environment variables
#
# Copy to .env and fill in values before running locally.
# Never commit actual values to version control.

# Existing Gateway URL (retained for non-migrated operations)
VITE_API_GATEWAY_URL="https://gateway-iota-two.vercel.app"

# NEW: Infrastructure Supabase project bootstrap configuration.
# These are the only two new frontend bootstrap variables.
# The Infrastructure project is the single configuration-discovery entry point;
# all domain-project URLs and anon keys are retrieved dynamically from its
# infrastructure_projects registry. Never use a service-role key here.
VITE_INFRA_SUPABASE_URL=
VITE_INFRA_SUPABASE_ANON_KEY=
